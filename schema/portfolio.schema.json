{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Takaven Portfolio Registry",
  "type": "object",
  "required": ["portfolio", "products"],
  "properties": {
    "portfolio": {
      "type": "object",
      "required": [
        "name",
        "discovery_status",
        "canonical_source",
        "last_reviewed",
        "design_system",
        "gate_model",
        "authority_model"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "discovery_status": { "const": "PORTFOLIO_DISCOVERY_CLOSED" },
        "canonical_source": { "const": "PORTFOLIO.yaml" },
        "last_reviewed": { "type": "string" },
        "operating_principle": { "type": "string" },
        "new_product_policy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_products": {
          "type": "array",
          "items": { "$ref": "#/$defs/external_product" }
        },
        "reserved_product_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/reserved_product_id" }
        },
        "design_system": { "$ref": "#/$defs/design_system" },
        "gate_model": { "$ref": "#/$defs/gate_model" },
        "authority_model": { "$ref": "#/$defs/authority_model" }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "EXISTING_CORE",
        "REVIVAL_IN_PROGRESS",
        "SHORTLIST_BUILD",
        "SHORTLIST_CONDITIONAL",
        "COMPONENT_ABSORB",
        "HOLD",
        "ARCHIVE"
      ]
    },
    "priority": {
      "enum": ["P0", "P1", "P2", "P3", "P2_MODULE", "P3_MODULE", "HOLD"]
    },
    "lifecycle_stage": {
      "enum": [
        "STAGE_0_ASSET_IDENTIFIED",
        "STAGE_1_PRODUCT_DEFINITION",
        "STAGE_2_BUILD_COMPLETION",
        "STAGE_3_PRODUCTION_HARDENING",
        "STAGE_4_MARKET_READY_PREPARATION",
        "STAGE_5_READY_TO_LAUNCH"
      ]
    },
    "evidence_confidence": {
      "enum": ["VERIFIED", "INFERRED", "UNVERIFIED"]
    },
    "source_role": {
      "enum": ["PRIMARY", "COMPONENT", "REFERENCE", "OBSOLETE"]
    },
    "source_type": {
      "enum": ["GITHUB_REPOSITORY", "REPLIT_EXPORT_OR_LOCAL_ASSET", "REFERENCE_ASSET", "OTHER"]
    },
    "locator_status": {
      "enum": ["VERIFIED", "UNVERIFIED", "LOCATOR_REQUIRED"]
    },
    "design_stage": {
      "enum": ["NOT_APPLICABLE", "NOT_STARTED", "D1_APPROVED", "D2_APPROVED", "D3_APPROVED", "D4_AUTHORISED"]
    },
    "review_classification": {
      "enum": ["BLOCKING", "MATERIAL", "NON_BLOCKING", "COSMETIC"]
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_version", "source_file", "brand_tokens_locked"],
      "properties": {
        "current_version": { "type": "string", "minLength": 1 },
        "source_file": { "const": "DESIGN-SYSTEM.md" },
        "brand_tokens_locked": { "type": "boolean" }
      }
    },
    "gate_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version",
        "uses_existing_fields",
        "review_classifications",
        "correction_loop_rule",
        "hard_stop_rule",
        "no_automatic_next_phase"
      ],
      "properties": {
        "model_version": { "type": "string", "minLength": 1 },
        "uses_existing_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_classifications": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/review_classification" }
        },
        "correction_loop_rule": { "type": "string", "minLength": 1 },
        "hard_stop_rule": { "type": "string", "minLength": 1 },
        "no_automatic_next_phase": { "const": true }
      }
    },
    "authority_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_roles",
        "agent_autonomous_actions",
        "founder_or_governance_approval_required"
      ],
      "properties": {
        "agent_roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "agent_autonomous_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "founder_or_governance_approval_required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "external_product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "relationship", "governance_rule"],
      "properties": {
        "name": { "type": "string" },
        "relationship": { "type": "string" },
        "governance_rule": { "type": "string" }
      }
    },
    "reserved_product_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^TKV-[0-9]{3}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "product_principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "description", "governance_rule"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["REQUIRED", "PROVISIONAL", "DEFERRED"] },
        "description": { "type": "string" },
        "provisional_terms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "governance_rule": { "type": "string" }
      }
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification",
        "role",
        "source_type",
        "locator_status",
        "evidence_confidence",
        "remarks"
      ],
      "properties": {
        "name": { "type": "string" },
        "classification": { "type": "string" },
        "role": { "$ref": "#/$defs/source_role" },
        "source_type": { "$ref": "#/$defs/source_type" },
        "owner_repository": { "type": "string" },
        "repository_url": { "type": "string" },
        "branch": { "type": "string" },
        "pinned_commit_sha": { "type": "string" },
        "local_or_replit_locator": { "type": "string" },
        "locator_status": { "$ref": "#/$defs/locator_status" },
        "evidence_confidence": { "$ref": "#/$defs/evidence_confidence" },
        "remarks": { "type": "string" }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "category",
        "status",
        "priority",
        "lifecycle_stage",
        "product_promise",
        "primary_buyer",
        "problem",
        "product_boundary",
        "exclusions",
        "source_assets",
        "current_execution_gate",
        "teamframe_relationship",
        "owner_current_workstream",
        "execution_ready",
        "evidence_confidence",
        "important_remarks",
        "design_governance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^TKV-[0-9]{3}$" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "lifecycle_stage": { "$ref": "#/$defs/lifecycle_stage" },
        "product_promise": { "type": "string" },
        "primary_buyer": { "type": "string" },
        "problem": { "type": "string" },
        "product_boundary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_asset" }
        },
        "source_repository_links": {
          "type": "array",
          "items": { "type": "string" }
        },
        "current_execution_gate": { "type": "string" },
        "condition_to_clear": { "type": "string" },
        "destination_product": { "type": "string" },
        "teamframe_relationship": { "type": "string" },
        "owner_current_workstream": { "type": "string" },
        "execution_ready": { "type": "boolean" },
        "evidence_confidence": { "$ref": "#/$defs/evidence_confidence" },
        "important_remarks": { "type": "string" },
        "design_governance": { "$ref": "#/$defs/design_governance" },
        "product_principles": {
          "type": "array",
          "items": { "$ref": "#/$defs/product_principle" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "SHORTLIST_CONDITIONAL" } } },
          "then": {
            "required": ["condition_to_clear"],
            "properties": { "condition_to_clear": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "COMPONENT_ABSORB" } } },
          "then": {
            "required": ["destination_product"],
            "properties": { "destination_product": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "COMPONENT_ABSORB" } } },
          "then": {
            "properties": {
              "design_governance": {
                "properties": { "design_stage": { "const": "NOT_APPLICABLE" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["REVIVAL_IN_PROGRESS", "SHORTLIST_BUILD", "SHORTLIST_CONDITIONAL", "HOLD"] } } },
          "then": {
            "properties": {
              "design_governance": {
                "properties": {
                  "design_stage": {
                    "enum": ["NOT_STARTED", "D1_APPROVED", "D2_APPROVED", "D3_APPROVED", "D4_AUTHORISED"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "design_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_stage",
        "design_system_version",
        "approved_d1_reference",
        "approved_d2_reference",
        "approved_d3_reference",
        "visual_profile_version"
      ],
      "properties": {
        "design_stage": { "$ref": "#/$defs/design_stage" },
        "design_system_version": { "type": "string", "minLength": 1 },
        "approved_d1_reference": { "type": "string" },
        "approved_d2_reference": { "type": "string" },
        "approved_d3_reference": { "type": "string" },
        "visual_profile_version": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "best_source", "destination_product", "why_retained", "reuse_instruction"],
      "properties": {
        "name": { "type": "string" },
        "best_source": { "type": "string" },
        "destination_product": { "type": "string" },
        "why_retained": { "type": "string" },
        "reuse_instruction": { "type": "string" }
      }
    }
  }
}
